# Copy to .env, fill in your settings, then: set -a; . ./.env; set +a
LISTEN_ADDR=127.0.0.1:8080
BASE_URL=http://localhost:8080
DATA_DIR=./data

# Generate with: openssl rand -hex 32
# Used for API access and signing admin sessions; browser login uses OIDC.
ADMIN_TOKEN_FILE=/absolute/path/to/admin-token

JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY_FILE=/absolute/path/to/jellyfin-api-key

AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_TOKEN_FILE=/absolute/path/to/authentik-api-token
AUTHENTIK_GROUPS=replace-with-media-users-group-uuid
AUTHENTIK_USER_PATH=users/media

AUTHENTIK_OIDC_ISSUER=https://auth.example.com/application/o/ms-invite/
AUTHENTIK_OIDC_CLIENT_ID=replace-with-client-id
AUTHENTIK_OIDC_CLIENT_SECRET_FILE=/absolute/path/to/oidc-client-secret
AUTHENTIK_ADMIN_GROUP=media-admins
